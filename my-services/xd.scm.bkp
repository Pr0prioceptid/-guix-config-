(define-module (my-services xd)
  #:use-module (gnu services)
  #:use-module (gnu services shepherd)
  #:use-module (guix gexp)
  #:use-module (my-packages xd))

(define-public my-xd-service
  (simple-service 
  'xd 
  shepherd-root-service-type 
  (list (shepherd-service 
  (provision '(xd-daemon)) 
  (requirement '(i2pd)) 
  (documentation "Run xd daemon.") 
  (start #~(make-forkexec-constructor 
  (list #$ (file-append go-github-com-majestrate-xd "/bin/XD")) 
  #:user "user" #:group "users"
  #:directory "/home/user/xd")) 
  (stop #~(make-kill-destructor))))))

(define-public my-xd-activation
  (simple-service
   'xd-activation
   activation-service-type
   #~(begin
       (use-modules (guix build utils))

       (mkdir-p "/home/user/xd")
       (chown "/home/user/xd"
              (passwd:uid (getpwnam "user"))
              (group:gid (getgrnam "users"))))))
